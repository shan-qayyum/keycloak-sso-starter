# Copy to app/.env and adjust. Never commit app/.env.

# Keycloak realm URL (the "issuer"). Must match what the browser sees.
OIDC_ISSUER=http://localhost:8089/realms/demo
OIDC_CLIENT_ID=demo-app

# Where this app is reachable. /callback is appended for the redirect URI.
APP_BASE_URL=http://localhost:3009
PORT=3009

# Random secret that signs the session cookie, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# Claim holding the user's roles. "roles" is added by the realm's protocol mapper;
# use realm_access.roles if you read Keycloak's default access-token layout instead.
OIDC_ROLES_CLAIM=roles

# Secure cookies default to on when APP_BASE_URL is https. Override if needed.
# COOKIE_SECURE=true
# Set to true when running behind a TLS-terminating reverse proxy.
# TRUST_PROXY=true
